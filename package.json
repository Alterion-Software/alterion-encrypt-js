{
  "name": "alterion-encrypt",
  "version": "1.1.4",
  "description": "X25519 ECDH key exchange, AES-256-GCM session encryption, and a MessagePack + Deflate request/response pipeline — framework-agnostic client-side counterpart to the alterion-encrypt Rust crate.",
  "license": "Apache-2.0",
  "author": "Alterion Software",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alterion-Software/alterion-encrypt-js"
  },
  "type": "module",
  "scripts": {
    "build": "tshy",
    "prepublishOnly": "npm run build"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts"
    },
    "dialects": [
      "esm",
      "commonjs"
    ]
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@noble/ciphers": "^2.1.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "msgpackr": "^1.11.10"
  },
  "devDependencies": {
    "tshy": "^4.1.1",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "picomatch": ">=4.0.4"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}

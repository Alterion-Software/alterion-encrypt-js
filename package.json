{
  "name": "alterion-encrypt",
  "version": "1.1.3",
  "description": "X25519 ECDH key exchange, AES-256-GCM session encryption, and a MessagePack + Deflate request/response pipeline — framework-agnostic client-side counterpart to the alterion-encrypt Rust crate.",
  "license": "Apache-2.0",
  "author": "Alterion Software",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alterion-Software/alterion-encrypt-js"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "msgpackr": "^1.11.10"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "picomatch": ">=4.0.4"
  }
}

{
  "name": "alterion-encrypt",
  "version": "1.2.0",
  "description": "X25519 ECDH key exchange, AES-256-GCM session encryption, and a MessagePack + Deflate request/response pipeline — framework-agnostic client-side counterpart to the alterion-encrypt Rust crate.",
  "license": "Apache-2.0",
  "author": "Alterion Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alterion-Software/alterion-encrypt-js.git"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
